	/* ==========================================================
     * BRAND URL SEARCH
     * ==========================================================
     *
     * BUSINESS PURPOSE:
     * - Retrieves Brand-level Site IDs and URLs eligible for
     *   Beyond Bonus (Brand calculation type)
     * - Used to proportionally allocate Beyond Bonus
     *   across eligible brand sites
     *
     * ELIGIBILITY RULES:
     * - Brand URL record must be active
     * - Linked to the same Vendor & Publisher Item
     * - Beyond flag must be enabled
     * - Publisher Program must be active
     * - Beyond Start Date ? Billing File Date
     *
     * @param {number} vendor       - Vendor Internal ID
     * @param {string} rVbDate      - Billing file date (string)
     * @param {Array}  siteIdArray  - Optional array to collect site IDs
     * @param {number} itemId       - Publisher Item Internal ID
     *
     * @returns {Array<Object>} Array of eligible brand objects:
     *   [{ siteId: '123', siteURL: 'example.com' }]
     */
    function getBrandUrlData(vendor, rVbDate, siteIdArray, itemId) 
	{

        var BrandUrlConsider = [];

        /* ----------------------------------------------------------
         * SAFE DATE PARSER
         * ---------------------------------------------------------- */
        var fileDateCompWithURL = parseDate(rVbDate);
        log.debug("Billing File Date (Brand Comparison)", fileDateCompWithURL);

        // If billing date is invalid, no brand URLs are eligible
        if (!fileDateCompWithURL) return BrandUrlConsider;

        /* ----------------------------------------------------------
         * BRAND URL SEARCH
         * ---------------------------------------------------------- */
        var urlSearch = search.create({
            type: "customrecord_publishers_url_link",
            filters: [
                // Active brand URL records only
                ["isinactive", "is", "F"],
                "AND",

                // Match Vendor (Publisher)
                ["custrecord_publisher_name_vendor", "anyof", vendor],
                "AND",

                // Match Publisher Item
                ["custrecord_publisher_item_name_number", "anyof", itemId],
                "AND",

                // Beyond bonus must be enabled for the brand
                ["custrecord_beyond", "is", "T"],
                "AND",

                // Publisher Program must be active
                ["custrecord_publisher_name_vendor.custentity_inactive_publisher_program", "is", "F"]
            ],
            columns: [
                "custrecord_publisher_url", // Brand URL
                "custrecord_beyond_start_date", // Beyond eligibility start date
                "custrecord_site_id" // Site ID
            ]
        });

        /* ----------------------------------------------------------
         * PROCESS BRAND URL RESULTS
         * ---------------------------------------------------------- */
        urlSearch.run().each(function(result) {

            // Beyond start date validation
            var pubBrandURLStartDate = result.getValue("custrecord_beyond_start_date");
            log.debug("Brand Beyond Start Date", pubBrandURLStartDate);

            if (!pubBrandURLStartDate) return true;

            var startDate = parseDate(pubBrandURLStartDate);
            log.debug("Parsed Brand Start Date", startDate);

            // Skip brand URLs not eligible for this billing period
            if (!startDate || fileDateCompWithURL.getTime() < startDate.getTime()) {
                return true;
            }

            var obj = {};

            // Capture Site ID (preferred identifier)
            var siteID = result.getValue("custrecord_site_id");
            log.debug("Brand Site ID", siteID);

            if (siteID) {
                obj.siteId = siteID;
                siteIdArray && siteIdArray.push(siteID);
            }

            // Capture Site URL (fallback identifier)
            var siteURL = result.getValue("custrecord_publisher_url");
            log.debug("Brand Site URL", siteURL);

            if (siteURL) {
                obj.siteURL = siteURL;
            }

            // Add to result list only if at least one identifier exists
            if (Object.keys(obj).length) {
                BrandUrlConsider.push(obj);
            }

            return true;
        });

        /* ----------------------------------------------------------
         * RETURN ELIGIBLE BRAND URL DATA
         * ---------------------------------------------------------- */
        return BrandUrlConsider;
    }


    /**
     * Calculates the last day of the month for a given date.
     *
     * USED FOR:
     * - Vendor Bill transaction date
     *
     * EXAMPLE:
     * - Input: 2025-01-10
     * - Output: 2025-01-31
     *
     * @param {Date} dateObj
     * @returns {Date|null} End-of-month date or null
     */
    function getEndOfMonth(dateObj) {
        if (!dateObj) return null;

        return new Date(
            dateObj.getFullYear(),
            dateObj.getMonth() + 1,
            0 // Day 0 returns the last day of the previous month
        );
    }
	
