/**
 * @NApiVersion 2.x
 * @NScriptType MapReduceScript
 * @NModuleScope SameAccount
 *
 * SUMMARY OF CHANGES FROM LEGACY SCRIPT:
 * - Refactored for readability and maintainability
 * - Reduced logic in map stage (grouping only)
 * - Centralized billing and bonus logic in reduce stage
 * - Simplified CSV parsing and date handling
 * - Removed unused UI/serverWidget dependencies
 */

define([
    'N/record', 'N/search', 'N/file', 'N/format', './papaparse.min.js', 'N/runtime', 'N/email'
], function(record, search, file, format, Papa, runtime, email) {

    /* ==========================================================
     * CONSTANTS
     * Centralized configuration replaces hard-coded values
     * used throughout the legacy script.
     * ========================================================== */

    var FOLDER_PENDING = 733; // Incoming billing files
    var FOLDER_PROCESSED = 732; // Successfully processed files
    var FOLDER_ERROR = 734; // Error CSV output

    var SUBSIDIARY_ID = 4; // SmartNews International Inc.
    var DEPARTMENT_ID = 2006; // A00391 CEO Approver : A00001 CEO : A00475 Business & Operations : A00063 US Media Business : A00309 US Media Partnerships
    var TAX_CODE = 7; // tax exemption
    var CURRENCY_ID = 2; // USD
    var PUB_BILL_FORM = 149; // Custom Form ID

    var BEYOND_ITEM_ID = 3640; // Beyond Bonus Non-Inventory Item
    var BEYOND_DEPARTMENT_ID = 4204; // A00391 CEO Approver : A00001 CEO : A00011 Technology : A00463 Project Beyond
    var BUSINESS_CATEGORY_ID = 4 // SmartNews Beyond
	
	var VIDEO_ITEM = 7069; // Video Beta Item
	
	

    var EMAIL_TO = ['sridhar.syagamreddy@smartnews.com'];
    var EMAIL_CC = ['seth.babu@smartnews.com'];

    /* ==========================================================
     * UTILITIES
     * ========================================================== */
	
	function parseDate(dateStr) {
    if (!dateStr) return null;

    // Already a Date object ?N normalize
    if (dateStr instanceof Date) {
        return new Date(
            dateStr.getFullYear(),
            dateStr.getMonth(),
            dateStr.getDate()
        );
    }

    dateStr = String(dateStr).trim();

    // YYYY-MM-DD or YYYY/MM/DD
    if (/^\d{4}[-\/]\d{2}[-\/]\d{2}$/.test(dateStr)) {
        var p = dateStr.replace(/\//g, '-').split('-');
        return new Date(p[0], p[1] - 1, p[2]);
    }

    // DD-MM-YYYY or DD/MM/YYYY
    if (/^\d{2}[-\/]\d{2}[-\/]\d{4}$/.test(dateStr)) {
        var p = dateStr.replace(/\//g, '-').split('-');
        return new Date(p[2], p[1] - 1, p[0]);
    }

    log.error('INVALID DATE FORMAT', dateStr);
    return null;
}

    /**
     * Escapes CSV values safely
     */
    function csvEscape(val) {
        if (val === null || val === undefined) return '""';
        val = String(val).replace(/"/g, '""').replace(/[\r\n]+/g, ' ');
        return '"' + val + '"';
    }

    /**
     * Business-readable action hints for Finance / Ops
     */
    function getActionHint(stage) {
        switch (stage) {
            case 'ITEM_RESOLUTION':
                return 'Item / External Id not found in NetSuite';
            case 'VENDOR_RESOLUTION':
                return 'Vendor / Publisher belongs to RevShare or is not found in NetSuite';
            case 'PRICING_TIER':
                return 'Matching Pricing Tier for page view range is not found in NetSuite';
            default:
                return 'Contact Finance Systems Team';
        }
    }

    // Generic null/empty validation helper
    function isValid(v) {
        return v !== null && v !== undefined && String(v).trim() !== '';
    }

    /* ==========================================================
     * INPUT STAGE
     * Retrieves all files from the Pending folder.
     * Legacy script performed additional environment checks
     * which are no longer required.
     * ========================================================== */
    function getInputData() {
        var files = [];
        search.create({
            type: 'folder',
            filters: [
                ['internalid', 'anyof', FOLDER_PENDING]
            ],
            columns: [{
                name: 'internalid',
                join: 'file'
            }]
        }).run().each(function(r) {
            var id = r.getValue({
                name: 'internalid',
                join: 'file'
            });
            if (id) files.push({
                fileId: id
            });
            return true;
        });
		 log.audit('FILES FOUND', files.length);
        return files;
    }
	
	    /* ==========================================================
     * MAP STAGE
     * CHANGE:
     * - Map stage now ONLY parses CSV and groups data
     * - No billing or calculation logic here
     * ========================================================== */
    function map(context) {
        var fileId = JSON.parse(context.value).fileId;
		log.audit('LOADING FILE', fileId);
        if (!fileId) return;

        var columns = Papa.parse(
            file.load({
                id: fileId
            }).getContents(), {
                skipEmptyLines: true
            }
        ).data;

        // Skip header row
        for (var i = 1; i < columns.length; i++) {
            var r = columns[i];
            if (!r || r.length < 17) continue;

            // Validate null check for required columns
            if (!r[2] || !r[6] || !r[9] || !(r[14] || r[15])) 
			{
                var errRow = r.slice();
                errRow.push(
                    'INPUT_VALIDATION',
                    'Missing mandatory column values',
                    'Fix required fields in source file'
                );

                context.write({
                    key: JSON.stringify({
                        fileId: fileId
                    }),
                    value: JSON.stringify({
                        errorData: errRow.map(csvEscape).join(',')
                    })
                });
                continue;
            }

            // ? ADD THIS BLOCK
            var smartViews = Number((r[8] || '0').replace(/,/g, ''));
            if (smartViews === 0) {
                continue; // Skip rows where SmartViews = 0
            }
			
			var itemName = (r[2] || '').toLowerCase().replace(' video', '').trim();

            // Group by file + item
            context.write({
                key: JSON.stringify({
                    fileId: fileId,
					item: itemName
                }),
                value: JSON.stringify({
                    originalRow: r,
                    siteName: r[6],
                    siteURL: r[4] || '',
                    siteId: r[3],
                    smartView: smartViews,
                    ingested: Number((r[16] ? r[16] : '0').replace(/,/g, '')),
                    externalId: r[2],
                    vbDate: r[9],
                    billDueDate: r[14] || r[15]
                })
            });
        }
    }
	
	/* ==========================================================
     * REDUCE STAGE
     * CHANGE:
     * - All aggregation, billing, and bonus logic is centralized here
     * - Improves traceability and debugging
     * ========================================================== */

	function reduce(context) {
		var key = JSON.parse(context.key);
		log.audit('LOADING FILE', key);

    /* ===============================
       PASS-THROUGH MAP ERRORS
    =============================== */
    if (!key.item) {
        var errorLines = [];

        context.values.forEach(function (v) {
            var val = JSON.parse(v);
            if (val && val.errorData) {
                errorLines.push(val.errorData);
            }
        });
	
        if (errorLines.length > 0) {
            context.write({
                key: key.fileId,
                value: {
                    errorData: errorLines.join('\r\n')
                }
            });
        }

        return;
    }
	/* ===============================
	   INITIALIZE VARIABLES
	=============================== */
	var fileId = key.fileId;
	var publisherItemName = key.item;
	log.debug("publisherItemName", publisherItemName);
	var hasVideo = false;
	var videoMG = 0;
	var vbDate = null;
	var billDueDate = null;
	var itemId = null;
	var vendorId = null;
	var monthlyFee = 0;
	var oldBillAmount = 0;
	var actualCPM = 0;
	var totalViews = 0;
	var totalIngested = 0;

	var errorRows = [];

    /* ===============================
       GROUPED SITE DATA
       KEY = ExternalID + SiteID
    =============================== */
    var siteGroup = {};
    context.values.forEach(function(v) {
        var r;
		try {
			r = JSON.parse(v);
		} catch (e) {
			return;
		}
        if (!vbDate) vbDate = r.vbDate;
		if (!billDueDate) billDueDate = r.billDueDate;
        var externalId = r.externalId || '';
		var siteId = r.siteId || '';
        var siteName = r.siteName || '';
        var siteURL = r.siteURL || '';
        var views = Number(r.smartView) || 0;
        var ingested = Number(r.ingested) || 0;
		var isVideo = externalId.toLowerCase().indexOf('video') !== -1;
			
		if (isVideo) {
			hasVideo = true;
			return;
		}
		totalViews += views;
        var groupKey = externalId + '|' + siteId;
        if (!siteGroup[groupKey]) {
            siteGroup[groupKey] = {
                externalId: externalId,
                siteId: siteId,
                siteName: siteName,
                siteURL: siteURL,
                smartViews: 0,
                ingested: 0,
                maxView: 0
            };
        }
        /* SmartViews always sum */
        siteGroup[groupKey].smartViews += views;
        /* Ingested should NOT sum */
        siteGroup[groupKey].ingested = Math.max(
            siteGroup[groupKey].ingested,
            ingested
        );
        /* Track highest view row for URL */
        if (views > siteGroup[groupKey].maxView) {
            siteGroup[groupKey].maxView = views;
            siteGroup[groupKey].siteURL = siteURL;
            siteGroup[groupKey].siteId = siteId;
        }
    });

    /* ===============================
       CALCULATE TOTAL INGESTED
    =============================== */
    Object.keys(siteGroup).forEach(function(k) {
        totalIngested += siteGroup[k].ingested;
    });

    /* ===============================
       BILLING EXECUTION
    =============================== */
    try {
        /* ---- ITEM RESOLUTION ---- */
		itemId = itemSearch(publisherItemName);
		vendorId = vendorSearch(itemId);
		if (!vendorId) {
			throw new Error('Vendor or Pricing Tier Not Found');
		}
		
		
		/* ===============================
		   VIDEO MG LOGIC (ADD HERE)
		=============================== */
		if (hasVideo) 
		{
			//videoMG = getProgramMGByName(publisherItemName + ' Video', vbDate);
			  // Step 1: Build video item name (normalized)
			var videoItemName = publisherItemName.toLowerCase() + ' video';

			// Step 2: Resolve item internal ID
			var videoItemId = itemSearch(videoItemName);

			log.debug("Video Item Resolution", {
				baseItem: publisherItemName,
				videoItemName: videoItemName,
				videoItemId: videoItemId
			});

			// Step 3: Get MG using INTERNAL ID
			if (videoItemId) {
				videoMG = getProgramMGByName(videoItemId, vbDate);
			} else {
				log.error("VIDEO ITEM NOT FOUND", videoItemName);
				videoMG = 0;
			}
		} else {
			videoMG = 0;
		}
		log.debug("Final Video MG", videoMG);
		
		
        /* ---- MINIMUM ARTICLE COMMITMENT ---- */
        var vendorFields = search.lookupFields({
            type: 'vendor',
            id: vendorId,
            columns: ['custentity_min_article_commitment']
        });
        var minimumCommitment = Number(vendorFields.custentity_min_article_commitment) || 0;
        log.audit('Minimum Commitment Check', {
            minimumCommitment: minimumCommitment,
            totalIngested: totalIngested
        });
        /* ===============================
           STEP 1 : OLD BILL AMOUNT
        =============================== */
        oldBillAmount = Number(getMonthlyFee(itemId, totalViews)) || 0;
        log.audit('Old Bill Amount', {
            oldBillAmount: oldBillAmount,
            totalViews: totalViews
        });

        /* ===============================
           STEP 2 : SV1ST LOGIC
        =============================== */
        if (oldBillAmount === 0) 
		{
            monthlyFee = 0;
        }
        else if (minimumCommitment < totalIngested) 
		{
           monthlyFee = oldBillAmount;
            log.audit('CASE 1 - OLD BILL', {
                ingested: totalIngested
            });
        }
        else {
            if (totalViews && totalViews !== 0) {
				actualCPM = parseFloat((oldBillAmount / (totalViews / 1000)).toFixed(2));
			}
            log.audit('Actual CPM', actualCPM);
            if (actualCPM < 2) {
                monthlyFee = oldBillAmount;
            }
            else {
                monthlyFee = 0;
            }
        }
        /* ===============================
           BUILD SITELINE MAP
           (compatible with createBill)
        =============================== */
        var siteMap = {};
        var siteGroupedMap = {};
        Object.keys(siteGroup).forEach(function(k) {
            var g = siteGroup[k];
            siteMap[g.siteName] = {
                siteName: g.siteName,
                siteId: g.siteId,
                siteURL: g.siteURL,
                smartView: g.smartViews,
                maxView: g.maxView
            };
            siteGroupedMap[g.siteId] = g.ingested;
        });
        /* ===============================
           CREATE BILL
        =============================== */
		log.debug("videoMG before bill", videoMG);
        createBill(
			vendorId,
			itemId,
			monthlyFee,
			siteMap,
			siteGroupedMap,
			totalViews,
			vbDate,
			PUB_BILL_FORM,
			billDueDate,
			totalIngested,
			actualCPM,
			oldBillAmount,
			videoMG
		);
    }
    catch (e) {
        var errorStage = 'UNKNOWN';
            if (!itemId) {
                errorStage = 'ITEM_RESOLUTION';
            } else if (!vendorId) {
                errorStage = 'VENDOR_RESOLUTION';
            } else if (monthlyFee === null || monthlyFee === undefined) {
				errorStage = 'PRICING_TIER';
			}
            context.values.forEach(function(v) {
                var rec = JSON.parse(v);
                var row = rec.originalRow.slice();
                row.push(
					getActionHint(errorStage)
				);
                errorRows.push(row.map(csvEscape).join(','));
            });
		log.error('CREATE BILL ERROR', e);
    }
    /* ===============================
       REDUCE OUTPUT
    =============================== */
    context.write({
        key: fileId,
        value: errorRows.length
            ? { errorData: errorRows.join('\r\n') }
            : {}
    });
}

/**
     * Resolves Item Internal ID using Publisher (Vendor) Name.
     *
     * BUSINESS PURPOSE:
     * - Each Publisher must have a corresponding Non-Inventory Item
     * - This item is used for Vendor Bill line creation
     *
     * SEARCH RULES:
     * 1. Item Type must be Non-Inventory
     * 2. Item Name must exactly match Publisher Name
     * 3. Item must be Active
     *
     * @param {string} publisherItemName - Publisher (Vendor) Name
     * @returns {number|null} Item Internal ID or null if not found
     */
    function itemSearch(publisherItemName) {
        try {
            var itemId = null;

            /**
             * Search Non-Inventory Items matching Publisher Name
             */
            var itemSearchObj = search.create({
                type: "noninventoryitem",
                filters: [
                    ["type", "anyof", "NonInvtPart"], // Non-Inventory Item
                    "AND",
                    ["name", "is", publisherItemName], // Exact name match
                    "AND",
                    ["isinactive", "is", "F"] // Active items only
                ],
                columns: [
                    search.createColumn({
                        name: "internalid"
                    })
                ]
            });

            // Log item count for traceability
            var count = itemSearchObj.runPaged().count;
            log.debug("Item Search Result Count", {
                publisherName: publisherItemName,
                count: count
            });

            /**
             * No item found ??N configuration issue
             * Billing cannot proceed without an Item
             */
            if (count === 0) {
                log.error({
                    title: "Item Search Failed",
                    details: {
                        publisherName: publisherItemName,
                        message: "No active Non-Inventory Item found"
                    }
                });
                return null;
            }

            /**
             * Retrieve first matching item
             * Assumption: One Item per Publisher
             */
            itemSearchObj.run().each(function(result) {
                itemId = result.getValue({
                    name: 'internalid'
                });
                return false; // stop after first match
            });

            // Log resolved Item ID
            log.debug({
                title: "Item Resolved",
                details: {
                    publisherName: publisherItemName,
                    itemId: itemId
                }
            });

            return itemId;

        } catch (e) {
            log.error({
                title: "Error in itemSearch",
                details: e
            });
            return null;
        }
    }
	

function getProgramMGByName(publisherItemId, vbDate) {
    try {
        /* ===============================
           VALIDATE BILLING DATE
        =============================== */
        var billDate = parseDate(vbDate);
        if (!billDate) {
            log.error('Invalid vbDate', vbDate);
            return 0;
        }

        /* ===============================
           BILLING MONTH WINDOW
        =============================== */
        var monthStart = new Date(
            billDate.getFullYear(),
            billDate.getMonth(),
            1
        );

        var monthEnd = new Date(
            billDate.getFullYear(),
            billDate.getMonth() + 1,
            0
        );

        var totalDays = monthEnd.getDate();
        var finalMG = 0;

        log.debug("MG Input", {
            publisherItemId: publisherItemId,
            vbDate: vbDate,
            monthStart: monthStart,
            monthEnd: monthEnd
        });

        /* ===============================
           SEARCH PROGRAM RECORDS
        =============================== */
        var programSearch = search.create({
            type: "customrecord_publishers_url_link",
            filters: [
                ["isinactive", "is", "F"],
                "AND",
                ["custrecord_publisher_item_name_number", "anyof", publisherItemId],
                "AND",
                ["custrecord_beyond", "is", "T"]
            ],
            columns: [
                "custrecord_flat_fee",
                "custrecord_beyond_start_date",
                "custrecord_pp_end_date"
            ]
        });

        programSearch.run().each(function (res) {

		var mg = Number(res.getValue("custrecord_flat_fee")) || 0;
            if (mg <= 0) return true;


			var rawStart = res.getValue("custrecord_beyond_start_date");
			var rawEnd   = res.getValue("custrecord_pp_end_date");

			log.debug("RAW PROGRAM DATES", {
				rawStart: rawStart,
				rawEnd: rawEnd
			});

            var progStart = parseDate(rawStart);
			var progEnd   = parseDate(rawEnd);

			log.debug("PARSED PROGRAM DATES", {
				progStart: progStart,
				progEnd: progEnd
			});

            if (!progStart) return true;

            log.debug("Program Record", {
                mg: mg,
                progStart: progStart,
                progEnd: progEnd
            });

            /* ===============================
               FULL MG (ONLY TRUE CASE)
               - No end date
               - Started BEFORE billing month
            =============================== */
            /* FULL MG */
			if (!progEnd && progStart <= monthEnd) {
				finalMG = Math.max(finalMG, mg);
				return true;
			}

            /* ===============================
               SKIP NON-OVERLAP
            =============================== */
            if (progStart > monthEnd) return true;
            if (progEnd && progEnd < monthStart) return true;


			log.debug("PRORATION INPUT", {
				progStart: progStart,
				progEnd: progEnd,
				monthStart: monthStart,
				monthEnd: monthEnd
			});

            /* ===============================
               PRORATION
            =============================== */
			
			var overlapStart = progStart > monthStart ? progStart : monthStart;

			var overlapEnd = progEnd
				? (progEnd < monthEnd ? progEnd : monthEnd)
				: monthEnd;

			log.debug("OVERLAP BEFORE NORMALIZE", {
				overlapStart: overlapStart,
				overlapEnd: overlapEnd
			});

			overlapStart = normalizeDate(overlapStart);
			overlapEnd   = normalizeDate(overlapEnd);

			log.debug("OVERLAP AFTER NORMALIZE", {
				overlapStart: overlapStart,
				overlapEnd: overlapEnd,
				diffDays: (overlapEnd - overlapStart) / 86400000
			});
			
			var activeDays = Math.round(
				(overlapEnd - overlapStart) / 86400000
			) + 1;

			log.debug("FINAL ACTIVE DAYS", activeDays);

            var proratedMG = (mg * activeDays) / totalDays;

            log.debug("PRORATED MG", {
                activeDays: activeDays,
                totalDays: totalDays,
                proratedMG: proratedMG
            });

            finalMG = Math.max(finalMG, proratedMG);

            return true;
        });

        finalMG = parseFloat((finalMG || 0).toFixed(2));

        log.audit("Final Video MG", {
            publisherItemId: publisherItemId,
            finalMG: finalMG
        });

        return finalMG;

    } catch (e) {
        log.error('Error in getProgramMGByName', e);
        return 0;
    }
}


function normalizeDate(d) {
    return new Date(d.getFullYear(), d.getMonth(), d.getDate());
}


/**
     * Resolves Vendor Internal ID using Publisher Item reference.
     *
     * BUSINESS PURPOSE:
     * - Each Publisher Item is linked to exactly one active Vendor
     * - Vendor must be eligible for billing (category + pricing tier mapping)
     *
     * FILTER LOGIC SUMMARY:
     * 1. Vendor is mapped to the Publisher Item
     * 2. Vendor category is eligible (monthly publishers/ quarterly publishers)
     * 3. Vendor has at least one active Pricing Tier record
     * 4. Vendor is active OR has no payment end date
     *
     * @param {number} publisherItemName - Publisher Item Internal ID
     * @returns {number|null} Vendor Internal ID or null if not found
     */
    function vendorSearch(publisherItemName) {
        try {
            var vendorId = null;

            /**
             * Search active Vendors linked to the Publisher Item
             * through Pricing Tier configuration.
             */
            var vendorSearchObj = search.create({
                type: "vendor",
                filters: [
                    // Vendor is linked to Publisher Item
                    ["custentity_publisher_item_name_number_n", "anyof", publisherItemName],
                    "AND",

                    // Only eligible vendor categories (Monthly Publisher / Quarterly Publishers)
                    ["category", "anyof", "6", "5"],
                    "AND",

                    // Vendor must have active Pricing Tier linked to the same Publisher Item
                    ["custrecord_pricing_tier_publisher.custrecord_pubr_item_name_num", "anyof", publisherItemName],
                    "AND",
                    ["custrecord_pricing_tier_publisher.isinactive", "is", "F"],
                    "AND",

                    // Vendor must be active OR have no payment end date
                    ["isinactive", "is", "F"]
                ],
                columns: [
                    search.createColumn({
                        name: "internalid"
                    })
                ]
            });

            // Log total vendors found for traceability
            var count = vendorSearchObj.runPaged().count;
            log.debug("vendorSearchResultCount", count);

            /**
             * No vendor found ??N configuration issue
             * Billing will be skipped for this publisher
             */
            if (count === 0) {
                log.error({
                    title: "Vendor Search Failed",
                    details: {
                        publisherItemId: publisherItemName,
                        message: "No eligible vendor found for publisher item"
                    }
                });
                return null;
            }

            /**
             * Fetch first matching vendor
             * Assumption: One active vendor per Publisher Item
             */
            vendorSearchObj.run().each(function(result) {
                vendorId = result.getValue({
                    name: 'internalid'
                });
                return false; // stop after first match
            });

            // Log resolved Vendor ID
            log.debug({
                title: "Vendor Resolved",
                details: {
                    publisherItemId: publisherItemName,
                    vendorId: vendorId
                }
            });

            return vendorId;

        } catch (e) {
            log.error({
                title: "Error in vendorSearch",
                details: e
            });
            return null;
        }
    }
	
	/* ==========================================================
     * Remaining helper functions (Monthly Fee, Vendor Search,
     * Item Search, Bonus logic, Summarize) remain FUNCTIONALLY
     * equivalent to legacy implementation with cleaner flow.
     * ========================================================== */
    /**
     * Calculates the Monthly Fee for a Publisher based on total page views
     * and pricing tiers defined in the Pricing Tier custom record.
     *
     * Pricing Types Supported:
     * 1 = Monthly Fee
     * 2 = Flat Rate
     * 3 = CPM Rate
     * 4 = Flat + CPM (overage calculation)
     *
     * @param {number} itemId  - Publisher Item Internal ID
     * @param {number} vbQty   - Total Page Views for the billing period
     * @returns {string} Monthly fee formatted to 2 decimal places
     */
    function getMonthlyFee(itemId, vbQty) {
        try {
            var monthlyFee = 0;

            /**
             * Search Pricing Tier records linked to the Publisher Item
             * Only active pricing tiers are considered.
             */
            var pricingSearch = search.create({
                type: "customrecord_sn_pricing_tier_list",
                filters: [
                    ["custrecord_pubr_item_name_num", "anyof", itemId],
                    "AND",
                    ["isinactive", "is", "F"]
                ],
                columns: [
                    "custrecord_sn_monthly_page_view", // Page view range (e.g. 10k-50k, 100k+)
                    "custrecord_sn_monthly_view", // Monthly Fee
                    "custrecord_cpm_rate", // CPM Rate
                    "custrecord_flat_rate", // Flat Rate
                    "custrecord_pricing_type" // Pricing Type
                ]
            });

            var results = pricingSearch.run().getRange({
                start: 0,
                end: 999
            });

            // No pricing tiers found ??N return 0
            if (!results || !results.length) return "0.00";

            /**
             * Iterate through pricing tiers and apply the first matching tier
             * based on total page views (vbQty).
             */
            for (var i = 0; i < results.length; i++) {

                var pageView = results[i].getValue('custrecord_sn_monthly_page_view');
                var priceType = Number(results[i].getValue('custrecord_pricing_type'));

                var flatRate = Number(results[i].getValue('custrecord_flat_rate')) || 0;
                var cpmRate = Number(results[i].getValue('custrecord_cpm_rate')) || 0;
                var monthlyVal = Number(results[i].getValue('custrecord_sn_monthly_view')) || 0;

                /* ==========================================================
                 * CASE 1: PAGE VIEW RANGE EXISTS
                 * ========================================================== */
                if (pageView) {

                    /**
                     * Range-based tier (e.g. 10,000-50,000)
                     */
                    if (pageView.indexOf('-') !== -1) {
                        var range = pageView.split('-');
                        var view1 = Number(range[0].replace(/,/g, ''));
                        var view2 = Number(range[1].replace(/,/g, ''));

                        if (vbQty >= view1 && vbQty <= view2) {

                            // Monthly Fee
                            if (priceType === 1) {
                                monthlyFee = monthlyVal;
                            }
                            // Flat Rate
                            else if (priceType === 2) {
                                monthlyFee = flatRate;
                            }
                            // CPM Rate
                            else if (priceType === 3) {
                                monthlyFee = (vbQty / 1000) * cpmRate;
                            }
                            break; // Stop once matching tier is applied
                        }
                    }

                    /**
                     * Plus-based tier (e.g. 100,000+)
                     */
                    if (pageView.indexOf('+') !== -1) {
                        var view = Number(pageView.replace('+', '').replace(/,/g, ''));

                        if (vbQty >= view) {

                            // Monthly Fee
                            if (priceType === 1) {
                                monthlyFee = monthlyVal;
                            }
                            // Flat Rate
                            else if (priceType === 2) {
                                monthlyFee = flatRate;
                            }
                            // CPM Rate
                            else if (priceType === 3) {
                                monthlyFee = (vbQty / 1000) * cpmRate;
                            }
                            // Flat + CPM overage
                            else if (priceType === 4) {
                                var feeDiff = vbQty - view;

                                if (feeDiff <= 0) {
                                    monthlyFee = flatRate;
                                } else {
                                    monthlyFee = flatRate + ((feeDiff / 1000) * cpmRate);
                                }
                            }
                            break;
                        }
                    }
                }

                /* ==========================================================
                 * CASE 2: PAGE VIEW FIELD IS EMPTY
                 * Used when pricing is independent of view ranges
                 * ========================================================== */
                else {
                    // Flat Rate only
                    if (priceType === 2) {
                        monthlyFee = flatRate;
                        break;
                    }
                    // CPM Rate only
                    else if (priceType === 3) {
                        monthlyFee = (vbQty / 1000) * cpmRate;
                        break;
                    }
                }
            }

            // Return formatted monthly fee
            return parseFloat(monthlyFee || 0).toFixed(2);

        } catch (e) {
            log.error('Error in Getting Monthly fee:', e);
            return "0.00";
        }
    }
	
